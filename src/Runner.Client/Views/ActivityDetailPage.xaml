<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Runner.Client.Views.ActivityDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             Title="{Binding Title}"
             x:DataType="vm:ActivityDetailPageViewModel"
             BackgroundColor="{StaticResource Bg}">

    <ContentPage.Resources>
        <Style x:Key="StatCard" BasedOn="{StaticResource Card}" TargetType="Border">
            <Setter Property="Padding" Value="12,14" />
        </Style>
        <Style x:Key="StatValue" BasedOn="{StaticResource Metric}" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
        </Style>
    </ContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20,12,20,24" Spacing="16">

            <!--  成绩：距离是这次跑步的主数字  -->
            <VerticalStackLayout Spacing="6">
                <Border HorizontalOptions="Center" Style="{StaticResource Tag}">
                    <Label FontSize="12" Text="{Binding WorkoutName}" TextColor="{StaticResource Accent}" />
                </Border>
                <Label FontSize="64" Style="{StaticResource Hero}" Text="{Binding Distance}" />
                <Label Style="{StaticResource MetricCaption}" Text="公里" />
            </VerticalStackLayout>

            <!--  轨迹草图  -->
            <Border Padding="0" Style="{StaticResource Card}">
                <GraphicsView Drawable="{Binding Trajectory}" HeightRequest="280" />
            </Border>

            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="10"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="10">
                <Border Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource StatValue}" Text="{Binding Duration}" />
                        <Label Style="{StaticResource MetricCaption}" Text="时长" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource StatValue}" Text="{Binding AverageSpeed}" />
                        <Label Style="{StaticResource MetricCaption}" Text="均速 km/h" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource StatValue}" Text="{Binding AverageCadence}" TextColor="{StaticResource Accent}" />
                        <Label Style="{StaticResource MetricCaption}" Text="均步频" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource StatValue}" Text="{Binding StepCount}" />
                        <Label Style="{StaticResource MetricCaption}" Text="步数" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource StatValue}" Text="{Binding TrackPointCount}" />
                        <Label Style="{StaticResource MetricCaption}" Text="轨迹点" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Text="{Binding TimeRange}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label HorizontalTextAlignment="Center"
                   IsVisible="{Binding HasMessage}"
                   Style="{StaticResource Caption}"
                   Text="{Binding Message}"
                   TextColor="{StaticResource Warn}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
