<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Runner.Client.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             Title="诊断"
             x:DataType="vm:DiagnosticsPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="{Binding DiagnosticNotice}" />
            <Label Text="{Binding MusicControlStatus}" />
            <!--  媒体控制  -->
            <Border Padding="15" BackgroundColor="LightGray" IsVisible="{Binding CanControlMusic}">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="媒体控制" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Button Command="{Binding PreviousTrackCommand}" HeightRequest="50" Text="上一首" WidthRequest="100" />
                        <Button Command="{Binding PlayPauseCommand}" HeightRequest="50" Text="播放/暂停" WidthRequest="100" />
                        <Button Command="{Binding NextTrackCommand}" HeightRequest="50" Text="下一首" WidthRequest="100" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!--  节拍器  -->
            <Border Padding="15" BackgroundColor="LightBlue">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="节拍器控制" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Button Command="{Binding StartTickCommand}" HeightRequest="50" Text="开始节拍" WidthRequest="120" />
                        <Button Command="{Binding StopTickCommand}" HeightRequest="50" Text="停止节拍" WidthRequest="120" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!--  计步器控制  -->
            <Border Padding="15" BackgroundColor="LightGreen">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="计步器控制" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Button Command="{Binding StartPedometerCommand}" HeightRequest="50" Text="开始计步" WidthRequest="100" />
                        <Button Command="{Binding StopPedometerCommand}" HeightRequest="50" Text="停止计步" WidthRequest="100" />
                        <Button Command="{Binding ResetStepCountCommand}" HeightRequest="50" Text="重置计数" WidthRequest="100" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!--  计步器数据  -->
            <Border Padding="15" BackgroundColor="LightYellow">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="计步器数据" />
                    <Label Text="{Binding PedometerStatus, StringFormat='状态: {0}'}" />
                    <Label FontAttributes="Bold" FontSize="20" Text="{Binding StepCount, StringFormat='步数: {0}'}" />
                    <Label FontAttributes="Bold" FontSize="20" Text="{Binding StepFrequency, StringFormat='步频: {0:F1} SPM'}" />
                </VerticalStackLayout>
            </Border>

            <!--  传感器切换  -->
            <Border Padding="15" BackgroundColor="LightCoral" IsVisible="{Binding CanSwitchStepCounter}">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="传感器切换" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Button Command="{Binding SwitchToHardwareCommand}" HeightRequest="50" Text="硬件传感器" WidthRequest="120" />
                        <Button Command="{Binding SwitchToAccelerometerCommand}" HeightRequest="50" Text="加速度传感器" WidthRequest="120" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!--  GPS 控制  -->
            <Border Padding="15" BackgroundColor="LightSkyBlue">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="GPS 距离追踪" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Button Command="{Binding StartGpsTrackingCommand}" HeightRequest="50" Text="开始追踪" WidthRequest="100" />
                        <Button Command="{Binding StopGpsTrackingCommand}" HeightRequest="50" Text="停止追踪" WidthRequest="100" />
                        <Button Command="{Binding ResetGpsDistanceCommand}" HeightRequest="50" Text="重置距离" WidthRequest="100" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!--  GPS 数据  -->
            <Border Padding="15" BackgroundColor="LightCyan">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="GPS 数据" />
                    <Label Text="{Binding GpsStatus, StringFormat='状态: {0}'}" />
                    <Label FontAttributes="Bold" FontSize="24" Text="{Binding GpsDistance, StringFormat='距离: {0:F3} 公里'}" />
                    <Label FontAttributes="Bold" FontSize="20" Text="{Binding GpsSpeed, StringFormat='速度: {0:F1} 公里/小时'}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
