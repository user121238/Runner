<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Runner.Client.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             Title="诊断"
             x:DataType="vm:DiagnosticsPageViewModel"
             BackgroundColor="{StaticResource Bg}">

    <ContentPage.Resources>
        <!--  调试操作按钮：次要胶囊压到 44 高，三个并排放得下；禁用时文字退成三级色，能看出当前不可点  -->
        <Style x:Key="ActionButton" BasedOn="{StaticResource SecondaryButton}" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="StatValue" BasedOn="{StaticResource Metric}" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
        </Style>
    </ContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20,12,20,24" Spacing="14">
            <Label Style="{StaticResource Hint}" Text="{Binding DiagnosticNotice}" />
            <Label Style="{StaticResource Caption}" Text="{Binding MusicControlStatus}" />

            <!--  媒体控制  -->
            <Border IsVisible="{Binding CanControlMusic}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource CardTitle}" Text="媒体控制" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Command="{Binding PreviousTrackCommand}" Style="{StaticResource ActionButton}" Text="上一首" />
                        <Button Grid.Column="1" Command="{Binding PlayPauseCommand}" Style="{StaticResource ActionButton}" Text="播放/暂停" />
                        <Button Grid.Column="2" Command="{Binding NextTrackCommand}" Style="{StaticResource ActionButton}" Text="下一首" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  节拍器  -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource CardTitle}" Text="节拍器控制" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Command="{Binding StartTickCommand}" Style="{StaticResource ActionButton}" Text="开始节拍" />
                        <Button Grid.Column="1" Command="{Binding StopTickCommand}" Style="{StaticResource ActionButton}" Text="停止节拍" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  计步器控制  -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource CardTitle}" Text="计步器控制" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Command="{Binding StartPedometerCommand}" Style="{StaticResource ActionButton}" Text="开始计步" />
                        <Button Grid.Column="1" Command="{Binding StopPedometerCommand}" Style="{StaticResource ActionButton}" Text="停止计步" />
                        <Button Grid.Column="2" Command="{Binding ResetStepCountCommand}" Style="{StaticResource ActionButton}" Text="重置计数" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  计步器数据  -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource CardTitle}" Text="计步器数据" />
                    <Label Style="{StaticResource CardDetail}" Text="{Binding PedometerStatus, StringFormat='状态: {0}'}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatValue}" Text="{Binding StepCount}" />
                            <Label Style="{StaticResource MetricCaption}" Text="步数" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Style="{StaticResource StatValue}" Text="{Binding StepFrequency, StringFormat='{0:F1}'}" />
                            <Label Style="{StaticResource MetricCaption}" Text="步频 SPM" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  传感器切换  -->
            <Border IsVisible="{Binding CanSwitchStepCounter}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource CardTitle}" Text="传感器切换" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Command="{Binding SwitchToHardwareCommand}" Style="{StaticResource ActionButton}" Text="硬件传感器" />
                        <Button Grid.Column="1" Command="{Binding SwitchToAccelerometerCommand}" Style="{StaticResource ActionButton}" Text="加速度传感器" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  GPS 控制  -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource CardTitle}" Text="GPS 距离追踪" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Command="{Binding StartGpsTrackingCommand}" Style="{StaticResource ActionButton}" Text="开始追踪" />
                        <Button Grid.Column="1" Command="{Binding StopGpsTrackingCommand}" Style="{StaticResource ActionButton}" Text="停止追踪" />
                        <Button Grid.Column="2" Command="{Binding ResetGpsDistanceCommand}" Style="{StaticResource ActionButton}" Text="重置距离" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  GPS 数据  -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource CardTitle}" Text="GPS 数据" />
                    <Label Style="{StaticResource CardDetail}" Text="{Binding GpsStatus, StringFormat='状态: {0}'}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource StatValue}" Text="{Binding GpsDistance, StringFormat='{0:F3}'}" />
                            <Label Style="{StaticResource MetricCaption}" Text="公里" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Style="{StaticResource StatValue}" Text="{Binding GpsSpeed, StringFormat='{0:F1}'}" />
                            <Label Style="{StaticResource MetricCaption}" Text="公里/小时" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
