<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Runner.Client.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             x:DataType="vm:HistoryViewModel"
             BackgroundColor="Black">

    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
        <Label FontSize="22" HorizontalTextAlignment="Center" Text="还没有跑步记录" TextColor="White" />
        <Label FontSize="14" HorizontalTextAlignment="Center" Text="结束一次跑步后会出现在这里" TextColor="#9E9E9E" />
    </VerticalStackLayout>

</ContentView>
