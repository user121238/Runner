<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Runner.Client.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             x:DataType="vm:HistoryViewModel"
             BackgroundColor="{StaticResource Bg}">

    <Grid Padding="20,10,20,14" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Label Style="{StaticResource PageTitle}" Text="记录" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10" VerticalOptions="Center">
                    <Image HeightRequest="48"
                           HorizontalOptions="Center"
                           Opacity="0.7"
                           Source="icon_history.png"
                           WidthRequest="48" />
                    <Label HorizontalTextAlignment="Center" Style="{StaticResource CardTitle}" Text="还没有跑步记录" />
                    <Label HorizontalTextAlignment="Center" Style="{StaticResource Hint}" Text="结束一次跑步（跑动至少 5 秒）后会出现在这里" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityListItem">
                    <Border Margin="0,0,0,10" Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=OpenCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <VerticalStackLayout MinimumWidthRequest="72" Spacing="0" VerticalOptions="Center">
                                <Label FontFamily="OpenSansSemibold"
                                       FontSize="28"
                                       Text="{Binding Distance}"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Style="{StaticResource Caption}" Text="公里" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Style="{StaticResource Body}" Text="{Binding Date}" />
                                <Label Style="{StaticResource CardDetail}" Text="{Binding Detail}" />
                                <Border HorizontalOptions="Start" IsVisible="{Binding HasWorkout}" Style="{StaticResource Tag}">
                                    <Label FontSize="11" Text="{Binding WorkoutName}" TextColor="{StaticResource Accent}" />
                                </Border>
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource GhostDangerButton}"
                                    Text="删除"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2"
               HorizontalTextAlignment="Center"
               IsVisible="{Binding HasMessage}"
               Style="{StaticResource Caption}"
               Text="{Binding Message}"
               TextColor="{StaticResource Warn}" />
    </Grid>

</ContentView>
