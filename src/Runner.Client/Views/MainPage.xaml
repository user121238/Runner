<?xml version="1.0" encoding="utf-8" ?>
<core:BaseContentPage x:Class="Runner.Client.Views.MainPage"
                      xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:core="clr-namespace:DM.Maui.Framework.Core.Mvvm;assembly=DM.Maui.Framework.Core"
                      xmlns:vm="clr-namespace:Runner.Client.ViewModels"
                      Title="{Binding Title}"
                      x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="*,50">
        <ScrollView>

            <VerticalStackLayout Spacing="15" VerticalOptions="Center">
                <Button Command="{Binding PreviousTrackCommand}"
                        HeightRequest="50"
                        Text="上一首"
                        WidthRequest="200" />
                <Button Command="{Binding NextTrackCommand}"
                        HeightRequest="50"
                        Text="下一首"
                        WidthRequest="200" />
                <Button Command="{Binding PlayPauseCommand}"
                        HeightRequest="50"
                        Text="暂停"
                        WidthRequest="200" />
                <Button Command="{Binding StartTickCommand}"
                        HeightRequest="50"
                        Text="播放提示音"
                        WidthRequest="200" />
                <Button Command="{Binding StopTickCommand}"
                        HeightRequest="50"
                        Text="暂停提示音"
                        WidthRequest="200" />
            </VerticalStackLayout>




        </ScrollView>
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*">
            <Button Text="首页" />
            <Button Grid.Column="1" Text="计划" />
            <Button Grid.Column="2" Text="记录" />
            <Button Grid.Column="3" Text="设置" />
        </Grid>
    </Grid>



</core:BaseContentPage>