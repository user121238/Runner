<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Runner.Client.Views.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:regions="clr-namespace:Prism.Navigation.Regions.Xaml;assembly=Prism.Maui"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             x:DataType="vm:MainPageViewModel"
             BackgroundColor="Black"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,64">
        <!--  首页 / 记录 / 设置 在此区域内切换  -->
        <ContentView regions:RegionManager.RegionName="MainRegion" />

        <Grid Grid.Row="1" BackgroundColor="#111111" ColumnDefinitions="*,*,*">
            <Button BackgroundColor="Transparent"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="RunView"
                    CornerRadius="0"
                    FontSize="16"
                    Text="首页"
                    TextColor="White" />
            <Button Grid.Column="1"
                    BackgroundColor="Transparent"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="HistoryView"
                    CornerRadius="0"
                    FontSize="16"
                    Text="记录"
                    TextColor="White" />
            <Button Grid.Column="2"
                    BackgroundColor="Transparent"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="SettingsView"
                    CornerRadius="0"
                    FontSize="16"
                    Text="设置"
                    TextColor="White" />
        </Grid>
    </Grid>

</ContentPage>
