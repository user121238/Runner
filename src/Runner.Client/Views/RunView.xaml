<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Runner.Client.Views.RunView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             x:DataType="vm:RunViewModel"
             BackgroundColor="Black">

    <ContentView.Resources>
        <Style x:Key="Metric" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="Label">
            <Setter Property="TextColor" Value="#9E9E9E" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentView.Resources>

    <Grid Padding="24,40,24,16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
        <Label Grid.Row="0" FontSize="16" Style="{StaticResource Caption}" Text="{Binding StatusText}" />

        <VerticalStackLayout Grid.Row="1" Spacing="28" VerticalOptions="Center">
            <VerticalStackLayout Spacing="2">
                <Label FontSize="76" Style="{StaticResource Metric}" Text="{Binding Elapsed}" />
                <Label Style="{StaticResource Caption}" Text="时长" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*">
                <VerticalStackLayout Spacing="2">
                    <Label FontSize="56" Style="{StaticResource Metric}" Text="{Binding DistanceKm, StringFormat='{}{0:F2}'}" />
                    <Label Style="{StaticResource Caption}" Text="公里" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label FontSize="56" Style="{StaticResource Metric}" Text="{Binding CadenceText}" TextColor="{Binding CadenceColor}" />
                    <Label Style="{StaticResource Caption}" Text="步频 SPM" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="2">
                <Label FontSize="40" Style="{StaticResource Metric}" Text="{Binding TargetCadence}" TextColor="#4CAF50" />
                <Label Style="{StaticResource Caption}" Text="目标步频 SPM" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Label Grid.Row="2" FontSize="14" HorizontalTextAlignment="Center" Text="{Binding Message}" TextColor="Orange" />

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Button BackgroundColor="White"
                    Command="{Binding PrimaryCommand}"
                    CornerRadius="40"
                    FontAttributes="Bold"
                    FontSize="28"
                    HeightRequest="80"
                    Text="{Binding PrimaryText}"
                    TextColor="Black" />
            <Button Grid.Column="1"
                    BackgroundColor="#B71C1C"
                    Command="{Binding StopCommand}"
                    CornerRadius="40"
                    FontSize="20"
                    HeightRequest="80"
                    IsVisible="{Binding CanStop}"
                    Text="结束"
                    TextColor="White"
                    WidthRequest="110" />
        </Grid>
    </Grid>

</ContentView>
