<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Runner.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{StaticResource Bg}">

    <VerticalStackLayout Padding="20,10,20,14" Spacing="14">
        <Label Style="{StaticResource PageTitle}" Text="设置" />

        <Border Padding="4" Style="{StaticResource Card}">
            <Grid Padding="12"
                  BackgroundColor="Transparent"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenDiagnosticsCommand}" />
                </Grid.GestureRecognizers>
                <Border Padding="0"
                        BackgroundColor="{StaticResource SurfaceAlt}"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="40">
                    <Image HeightRequest="22"
                           HorizontalOptions="Center"
                           Source="icon_settings_on.png"
                           VerticalOptions="Center"
                           WidthRequest="22" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Style="{StaticResource Body}" Text="诊断" />
                    <Label Style="{StaticResource CardDetail}" Text="单独起停计步、GPS、节拍器与切歌，排查传感器问题" />
                </VerticalStackLayout>
                <Label Grid.Column="2"
                       FontSize="22"
                       Text="›"
                       TextColor="{StaticResource TextTertiary}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <Label Style="{StaticResource Hint}" Text="步频、时长 / 距离与切歌都在「课程」里按阶段定义，这里不另设全局步频。" />
    </VerticalStackLayout>

</ContentView>
