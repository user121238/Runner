<?xml version="1.0" encoding="utf-8" ?>
<core:BaseContentPage x:Class="Runner.Client.Views.WatchWorkoutPage"
                      xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:core="clr-namespace:DM.Maui.Framework.Core.Mvvm;assembly=DM.Maui.Framework.Core"
                      xmlns:vm="clr-namespace:Runner.Client.ViewModels"
                      Title="手表跑步"
                      x:DataType="vm:WatchWorkoutViewModel">

    <Grid Padding="16" RowDefinitions="Auto,*,Auto,Auto">

        <Frame Padding="12" BackgroundColor="#F0F0F0" CornerRadius="12">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding ConnectionStatus}" FontSize="14" TextColor="Gray" />
                <Label Text="{Binding DeviceName}" FontSize="16" FontAttributes="Bold" />
                <Label Text="{Binding ScanResult}" FontSize="12" TextColor="DarkGray" />
            </VerticalStackLayout>
        </Frame>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="20" BackgroundColor="#1a1a2e" StrokeShape="RoundRectangle 16">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="20" ColumnSpacing="16">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding HeartRate}" FontSize="48" FontAttributes="Bold" TextColor="#ff4757" HorizontalTextAlignment="Center" />
                    <Label Text="心率" FontSize="12" TextColor="#7f8c8d" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding Cadence}" FontSize="48" FontAttributes="Bold" TextColor="#2ed573" HorizontalTextAlignment="Center" />
                    <Label Text="步频" FontSize="12" TextColor="#7f8c8d" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center">
                    <Label Text="{Binding Elapsed}" FontSize="42" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                    <Label Text="时长" FontSize="12" TextColor="#7f8c8d" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="1" Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="{Binding Distance}" FontSize="42" FontAttributes="Bold" TextColor="#1e90ff" HorizontalTextAlignment="Center" />
                    <Label Text="距离 (km)" FontSize="12" TextColor="#7f8c8d" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="2" HorizontalOptions="Center">
                    <Label Text="{Binding Pace}" FontSize="28" FontAttributes="Bold" TextColor="#ffa502" HorizontalTextAlignment="Center" />
                    <Label Text="配速" FontSize="12" TextColor="#7f8c8d" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2" Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="{Binding Calories}" FontSize="28" FontAttributes="Bold" TextColor="#ff6348" HorizontalTextAlignment="Center" />
                    <Label Text="卡路里" FontSize="12" TextColor="#7f8c8d" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" HorizontalOptions="Center">
                    <Label Text="{Binding Steps}" FontSize="28" FontAttributes="Bold" TextColor="#dfe6e9" HorizontalTextAlignment="Center" />
                    <Label Text="步数" FontSize="12" TextColor="#7f8c8d" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <HorizontalStackLayout Grid.Row="2" Margin="0,16,0,0" HorizontalOptions="Center" Spacing="16">
            <Button Text="扫描" Command="{Binding ScanCommand}" IsEnabled="{Binding IsNotScanning}" WidthRequest="75" />
            <Button Text="DB读" Command="{Binding ReadFromDbCommand}" BackgroundColor="#a29bfe" TextColor="White" WidthRequest="75" />
            <Button Text="开始" Command="{Binding StartWorkoutCommand}" BackgroundColor="#2ed573" TextColor="White" WidthRequest="75" />
            <Button Text="停止" Command="{Binding StopWorkoutCommand}" BackgroundColor="#ff4757" TextColor="White" WidthRequest="75" />
            <Button Text="断开" Command="{Binding DisconnectCommand}" BackgroundColor="#ffa502" TextColor="White" WidthRequest="75" />
        </HorizontalStackLayout>

        <Frame Grid.Row="3" Padding="12" BackgroundColor="#FEF9E7" CornerRadius="12" IsVisible="{Binding HasSummary}">
            <VerticalStackLayout Spacing="4">
                <Label Text="运动汇总" FontAttributes="Bold" FontSize="16" />
                <Label Text="{Binding TotalDuration, StringFormat='时长: {0}'}" FontSize="14" />
                <Label Text="{Binding TotalDistance, StringFormat='距离: {0}'}" FontSize="14" />
                <Label Text="{Binding TotalCalories, StringFormat='卡路里: {0}'}" FontSize="14" />
                <Label Text="{Binding AvgHeartRate, StringFormat='平均心率: {0}'}" FontSize="14" />
                <Label Text="{Binding AvgCadence, StringFormat='平均步频: {0}'}" FontSize="14" />
                <Label Text="{Binding TotalSteps, StringFormat='总步数: {0}'}" FontSize="14" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</core:BaseContentPage>
