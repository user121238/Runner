<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Runner.Client.Views.WorkoutEditorPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             Title="{Binding Title}"
             x:DataType="vm:WorkoutEditorPageViewModel"
             BackgroundColor="{StaticResource Bg}">

    <!--  底边避让软键盘：输入时保存按钮和表单一起上移，不被键盘盖住  -->
    <Grid Padding="20,12,20,14"
          RowDefinitions="*,Auto"
          RowSpacing="12"
          SafeAreaEdges="Container,Container,Container,SoftInput">
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="14">

                <!--  名称与轮数  -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource SectionTitle}" Text="基本信息" />
                        <Border Style="{StaticResource InputBox}">
                            <Entry Placeholder="课程名称，例如：法特莱克" Style="{StaticResource InputText}" Text="{Binding Name}" />
                        </Border>
                        <Grid ColumnDefinitions="*,Auto,56,Auto" ColumnSpacing="6">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Style="{StaticResource Body}" Text="重复轮数" />
                                <Label Style="{StaticResource CardDetail}" Text="所有阶段按顺序跑完算一轮" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Command="{Binding DecreaseRoundsCommand}"
                                    Style="{StaticResource IconButton}"
                                    Text="−" />
                            <Label Grid.Column="2"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="22"
                                   HorizontalTextAlignment="Center"
                                   Text="{Binding Rounds}"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalTextAlignment="Center" />
                            <Button Grid.Column="3"
                                    Command="{Binding IncreaseRoundsCommand}"
                                    Style="{StaticResource IconButton}"
                                    Text="+" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="4,4,4,0">
                    <Label Style="{StaticResource SectionTitle}" Text="阶段" VerticalOptions="Center" />
                    <Label Grid.Column="1" Style="{StaticResource Hint}" Text="按顺序执行，每轮重复" />
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stages}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:StageEditModel">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" VerticalOptions="Center" />
                                        <Button Grid.Column="1"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutEditorPageViewModel}}, Path=RemoveStageCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource GhostDangerButton}"
                                                Text="删除" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Style="{StaticResource Body}" Text="步频" />
                                            <Label Style="{StaticResource CardDetail}" Text="SPM，填 0 表示本阶段不播节拍" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" Style="{StaticResource InputBox}">
                                            <Entry HorizontalTextAlignment="Center"
                                                   Keyboard="Numeric"
                                                   Style="{StaticResource InputText}"
                                                   Text="{Binding CadenceText}" />
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label Style="{StaticResource Body}" Text="结束条件" VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                Padding="3"
                                                BackgroundColor="{StaticResource SurfaceAlt}"
                                                StrokeShape="RoundRectangle 13"
                                                StrokeThickness="0">
                                            <HorizontalStackLayout Spacing="2">
                                                <Button Command="{Binding UseDurationCommand}" Style="{StaticResource SegmentButton}" Text="按时长">
                                                    <Button.Triggers>
                                                        <DataTrigger Binding="{Binding IsDuration}" TargetType="Button" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                                            <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                                <Button Command="{Binding UseDistanceCommand}" Style="{StaticResource SegmentButton}" Text="按距离">
                                                    <Button.Triggers>
                                                        <DataTrigger Binding="{Binding IsDuration}" TargetType="Button" Value="False">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                                            <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                                        <Label Style="{StaticResource Body}" Text="{Binding ValueLabel}" VerticalOptions="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource InputBox}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <Entry HorizontalTextAlignment="Center"
                                                       Keyboard="Numeric"
                                                       Style="{StaticResource InputText}"
                                                       Text="{Binding EndValueText}" />
                                                <Label Grid.Column="1"
                                                       Style="{StaticResource CardDetail}"
                                                       Text="{Binding Unit}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Style="{StaticResource Body}" Text="进入时切下一首歌" />
                                            <Label Style="{StaticResource CardDetail}" Text="用换歌提醒你：节奏变了" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1" IsToggled="{Binding SwitchTrackOnEnter}" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Command="{Binding AddStageCommand}"
                        FontSize="15"
                        HeightRequest="48"
                        Style="{StaticResource SecondaryButton}"
                        Text="＋ 添加阶段" />

                <Label HorizontalTextAlignment="Center"
                       IsVisible="{Binding HasMessage}"
                       Style="{StaticResource Caption}"
                       Text="{Binding Message}"
                       TextColor="{StaticResource Warn}" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButton}"
                Text="保存课程" />
    </Grid>

</ContentPage>
