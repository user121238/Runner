<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Runner.Client.Views.WorkoutEditorPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             Title="{Binding Title}"
             x:DataType="vm:WorkoutEditorPageViewModel"
             BackgroundColor="Black">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#1E1E1E" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="Field" TargetType="Entry">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BackgroundColor" Value="#2A2A2A" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="WidthRequest" Value="110" />
        </Style>
        <Style x:Key="Toggle" TargetType="Button">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="WidthRequest" Value="72" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="Stepper" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#333333" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="16" RowDefinitions="*,Auto" RowSpacing="12">
        <ScrollView>
            <VerticalStackLayout Spacing="14">
                <!--  名称与轮数  -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource FieldLabel}" Text="课程名称" />
                        <Entry BackgroundColor="#2A2A2A" Placeholder="例如：法特莱克" PlaceholderColor="#777777" Text="{Binding Name}" TextColor="White" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <Label Style="{StaticResource FieldLabel}" Text="重复轮数" />
                            <Button Grid.Column="1" Command="{Binding DecreaseRoundsCommand}" Style="{StaticResource Stepper}" Text="−" />
                            <Label Grid.Column="2"
                                   FontAttributes="Bold"
                                   FontSize="24"
                                   HorizontalTextAlignment="Center"
                                   Text="{Binding Rounds}"
                                   TextColor="White"
                                   VerticalTextAlignment="Center"
                                   WidthRequest="56" />
                            <Button Grid.Column="3" Command="{Binding IncreaseRoundsCommand}" Style="{StaticResource Stepper}" Text="+" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label FontSize="18" Text="阶段（按顺序执行，每轮重复）" TextColor="White" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stages}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:StageEditModel">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label FontAttributes="Bold" Style="{StaticResource FieldLabel}" Text="{Binding Title}" />
                                        <Button Grid.Column="1"
                                                BackgroundColor="#B71C1C"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutEditorPageViewModel}}, Path=RemoveStageCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource Toggle}"
                                                Text="删除" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Style="{StaticResource FieldLabel}" Text="步频 SPM（0 = 不播节拍）" />
                                        <Entry Grid.Column="1" Keyboard="Numeric" Style="{StaticResource Field}" Text="{Binding CadenceText}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Label Style="{StaticResource FieldLabel}" Text="结束条件（二选一）" />
                                        <Button Grid.Column="1" BackgroundColor="{Binding DurationButtonColor}" Command="{Binding UseDurationCommand}" Style="{StaticResource Toggle}" Text="时长" />
                                        <Button Grid.Column="2" BackgroundColor="{Binding DistanceButtonColor}" Command="{Binding UseDistanceCommand}" Style="{StaticResource Toggle}" Text="距离" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Label Style="{StaticResource FieldLabel}" Text="{Binding ValueLabel}" />
                                        <Entry Grid.Column="1" Keyboard="Numeric" Style="{StaticResource Field}" Text="{Binding EndValueText}" />
                                        <Label Grid.Column="2" Style="{StaticResource FieldLabel}" Text="{Binding Unit}" WidthRequest="40" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{StaticResource FieldLabel}" Text="进入该阶段时切下一首歌" />
                                        <Switch Grid.Column="1" IsToggled="{Binding SwitchTrackOnEnter}" OnColor="#4CAF50" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button BackgroundColor="#333333"
                        Command="{Binding AddStageCommand}"
                        CornerRadius="8"
                        HeightRequest="48"
                        Text="添加阶段"
                        TextColor="White" />

                <Label FontSize="14" Text="{Binding Message}" TextColor="Orange" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                BackgroundColor="White"
                Command="{Binding SaveCommand}"
                CornerRadius="28"
                FontAttributes="Bold"
                FontSize="18"
                HeightRequest="56"
                Text="保存"
                TextColor="Black" />
    </Grid>

</ContentPage>
