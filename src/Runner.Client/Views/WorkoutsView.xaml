<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Runner.Client.Views.WorkoutsView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             x:DataType="vm:WorkoutsViewModel"
             BackgroundColor="{StaticResource Bg}">

    <Grid Padding="20,10,20,14" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Label Style="{StaticResource PageTitle}" Text="课程" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10" VerticalOptions="Center">
                    <Image HeightRequest="48"
                           HorizontalOptions="Center"
                           Opacity="0.7"
                           Source="icon_course.png"
                           WidthRequest="48" />
                    <Label HorizontalTextAlignment="Center" Style="{StaticResource CardTitle}" Text="还没有课程" />
                    <Label HorizontalTextAlignment="Center"
                           Style="{StaticResource Hint}"
                           Text="按阶段设定步频与时长或距离，到节点自动切歌。&#10;比如：180 步频 2 分钟 → 120 步频 1 分钟，重复 4 轮。" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkoutListItem">
                    <Border Margin="0,0,0,10" Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutsViewModel}}, Path=EditCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="4">
                            <Label Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                            <Label Grid.Column="1"
                                   FontSize="22"
                                   Text="›"
                                   TextColor="{StaticResource TextTertiary}"
                                   VerticalOptions="Start" />
                            <Label Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Style="{StaticResource CardDetail}"
                                   Text="{Binding Summary}" />
                            <Grid Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  Margin="0,6,0,0"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <Label FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       Style="{StaticResource Body}"
                                       Text="{Binding Stages}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutsViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource GhostDangerButton}"
                                        Text="删除" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label HorizontalTextAlignment="Center"
                   IsVisible="{Binding HasMessage}"
                   Style="{StaticResource Caption}"
                   Text="{Binding Message}"
                   TextColor="{StaticResource Warn}" />
            <Button Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" Text="新建课程" />
        </VerticalStackLayout>
    </Grid>

</ContentView>
