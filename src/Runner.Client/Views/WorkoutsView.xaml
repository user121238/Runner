<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Runner.Client.Views.WorkoutsView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Runner.Client.ViewModels"
             x:DataType="vm:WorkoutsViewModel"
             BackgroundColor="Black">

    <Grid Padding="24,40,24,16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Label FontSize="22" Text="课程" TextColor="White" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label HorizontalTextAlignment="Center"
                       Text="还没有课程，点下面新建一个"
                       TextColor="#9E9E9E"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkoutListItem">
                    <Border Margin="0,0,0,10"
                            Padding="16"
                            BackgroundColor="#1E1E1E"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label FontAttributes="Bold" FontSize="18" Text="{Binding Name}" TextColor="White" />
                                <Label FontSize="13" Text="{Binding Summary}" TextColor="#9E9E9E" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    BackgroundColor="#333333"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutsViewModel}}, Path=EditCommand}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="8"
                                    Text="编辑"
                                    TextColor="White" />
                            <Button Grid.Column="2"
                                    BackgroundColor="#B71C1C"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutsViewModel}}, Path=DeleteCommand}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="8"
                                    Text="删除"
                                    TextColor="White" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                BackgroundColor="White"
                Command="{Binding CreateCommand}"
                CornerRadius="28"
                FontAttributes="Bold"
                FontSize="18"
                HeightRequest="56"
                Text="新建课程"
                TextColor="Black" />
    </Grid>

</ContentView>
